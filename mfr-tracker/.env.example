# Copy to .env.local. With this file absent or empty the app runs in local mode:
# embedded database and files under .data/, AI reading switched off.

# --- AI reading (optional in local mode, needed for scan reading) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_MODE=anthropic | mock | off   (derived from the key when unset)

# --- Cloud mode: set all of these for the shared deployment ---
# Supabase > Connect > Transaction pooler (port 6543)
DATABASE_URL=
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase > Settings > API Keys > Secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=mfr-scans
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- First admin login, used by `npm run seed` and `npm run go-live` ---
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
